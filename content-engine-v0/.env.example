# LLM (OpenAI-compatible)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
REQUEST_TIMEOUT_SECONDS=30
DEFAULT_VARIANTS=3

# Instagram Graph API
# How to get these:
#   1. Create a Facebook App at developers.facebook.com
#   2. Add the Instagram product, connect an Instagram Business/Creator account
#   3. Generate a long-lived token with instagram_content_publish scope
#   4. Your numeric user ID appears in the Graph API Explorer
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
