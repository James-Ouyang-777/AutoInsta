# LLM (OpenAI-compatible) — used for both caption generation and DALL-E images
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-1
REQUEST_TIMEOUT_SECONDS=30
DEFAULT_VARIANTS=3

# fal.ai — only needed for --type video (5-second Reels)
# Get a key at fal.ai/dashboard/keys
FAL_KEY=
# Alternate key name also accepted by code:
# FAL_API_KEY=

# Optional (needed when IMAGE_MODEL returns base64 instead of a URL, e.g. gpt-image-1):
# configure an unsigned upload preset in Cloudinary, then set:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Instagram Graph API
# How to get these:
#   1. Create a Facebook App at developers.facebook.com
#   2. Add the Instagram product, connect an Instagram Business/Creator account
#   3. Generate a long-lived token with instagram_content_publish scope
#   4. Your numeric user ID appears in the Graph API Explorer
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Brand pipeline (daily_brand_post.py, create_post.py, animate_post.py,
# generate_reference.py) — selects brands/<name>/ (brand_style.yaml,
# scenes.yaml, references/). Defaults to jammy-o if unset.
BRAND=jammy-o
